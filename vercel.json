{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm install --no-audit --no-fund --prefer-offline && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[[...slug]].ts": {
      "includeFiles": "server/src/data/china-cities.json"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
